# ============================================================
#  Atlas Scraper — Environment Config
# ============================================================

# ── General ──────────────────────────────────────────────────
# Switch between 'development' and 'production' (or 'prod')
NODE_ENV=development
PORT=5070

# ── Development Specific (Auto-selected if NODE_ENV=development) ─────────────
DEV_MONGODB_URI=mongodb://127.0.0.1:27050/atlas
DEV_REDIS_HOST=127.0.0.1
DEV_REDIS_PORT=6847
DEV_MEDIA_BASE_URL=http://localhost:5070/media
DEV_PUBLIC_BASE_URL=http://localhost:5070

# ── Production Specific (Auto-selected if NODE_ENV=production) ───────────────
# When running with Docker Compose, use 'mongo' and 'redis' container names
PROD_MONGODB_URI=mongodb://mongo:27051/atlas
PROD_REDIS_HOST=redis
PROD_REDIS_PORT=6379
PROD_MEDIA_BASE_URL=https://atlas.onepassgym.com/media
PROD_PUBLIC_BASE_URL=https://atlas.onepassgym.com

# ── Public app URL for docs/frontend config ─────────────────────────────────
API_ATLAS_BASE_URL=https://onepassgym.com/api-atlas
PUBLIC_BASE_URL=http://localhost:5070

# ── MongoDB Common ───────────────────────────────────────────
MONGODB_DB_NAME=atlas

# ── Redis Common ─────────────────────────────────────────────
REDIS_PASSWORD=

# ── Media Storage ────────────────────────────────────────────
MEDIA_BASE_PATH=./media

# ── Scraper Behaviour ────────────────────────────────────────
# BullMQ concurrency per worker replica (batch jobs processed at once)
SCRAPER_CONCURRENCY=3
# Inter-URL delay (ms) — stealth plugin handles anti-detection
SCRAPER_DELAY_MIN=300
SCRAPER_DELAY_MAX=800
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_HEADLESS=true
# Parallel browser tabs per batch job (6 for 8GB VPS, 3 for 4GB)
SCRAPER_PAGE_POOL=6
# Parallel search pages for discovery phase
SCRAPER_SEARCH_POOL=3
# Skip gyms crawled within N days on re-crawl (0 = always re-scrape)
SCRAPER_SKIP_RECENT_DAYS=7
# Phase 9: URLs per batch job (smaller = more parallelism)
SCRAPER_BATCH_SIZE=15
# Depth caps: 'standard' uses these, 'deep' = 150/80, 'fast' = 0
SCRAPER_MAX_REVIEWS=30
SCRAPER_MAX_PHOTOS=20
# Media worker concurrency (pure I/O, no Chromium — 8-10 is fine)
MEDIA_WORKER_CONCURRENCY=8

# Google Maps search phrases (comma-separated). Real-world terms, e.g. add
# "coworking space" here to discover coworking venues.
# SCRAPER_CATEGORIES=gym,fitness center,yoga studio,crossfit,pilates studio,martial arts gym,boxing gym,dance fitness studio,personal training studio,swimming club
# Human-like pause every N URLs (min/max) for M ms (min/max)
SCRAPER_PAUSE_EVERY_MIN=10
SCRAPER_PAUSE_EVERY_MAX=16
SCRAPER_PAUSE_MS_MIN=3000
SCRAPER_PAUSE_MS_MAX=8000
# Drop obvious non-venues (cafés, banks, hotels…) from category crawls
SCRAPER_RELEVANCE_FILTER=true
# Visit the venue website inside the Google crawl loop (slow; enrichment does this instead)
SCRAPER_WEBSITE_IN_CRAWL=false

# ── Continuous enrichment (npm run worker:enrich) ────────────
# Parallel lanes (1 browser each, ~300MB RAM per lane)
ENRICHMENT_CONCURRENCY=2
ENRICHMENT_DELAY=1500
# Google pass depth in the endless loop (deep jobs still use ENRICHMENT_MAX_*)
ENRICHMENT_LOOP_MAX_REVIEWS=60
ENRICHMENT_LOOP_MAX_PHOTOS=60
# How often each source re-visits a record, and rotation weights
ENRICH_GOOGLE_REFRESH_DAYS=7
ENRICH_WEBSITE_REFRESH_DAYS=30
ENRICH_GOOGLE_WEIGHT=2
ENRICH_WEBSITE_WEIGHT=1
# Pause only the Google source after a block (website source keeps running)
ENRICHMENT_BLOCK_COOLDOWN_MS=180000

# ── Telemetry (Live Pipeline dashboard) ──────────────────────
TELEMETRY_HEARTBEAT_MS=5000

# ── Deduplication ────────────────────────────────────────────
DEDUP_RADIUS_METERS=50

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
